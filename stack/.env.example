# ─── Stack version ───────────────────────────────────────────────────────────
# Keep every component on the same version. 9.5.1 is current as of 2026-08.
STACK_VERSION=9.5.1
GRAFANA_VERSION=12.2.0

# ─── Identity of this host on your LAN ───────────────────────────────────────
# The IP (and optional DNS name) that Proxmox + your VMs will use to reach this
# box. These values are baked into the TLS certificates, so get them right
# BEFORE running setup-certs.sh. Re-run that script if they ever change.
STACK_IP=192.168.1.50
STACK_DNS=elk.lan

# ─── Credentials (CHANGE THESE) ──────────────────────────────────────────────
ELASTIC_PASSWORD=changeme_elastic_superuser
KIBANA_SYSTEM_PASSWORD=changeme_kibana_system
LOGSTASH_WRITER_PASSWORD=changeme_logstash_writer
GRAFANA_READER_PASSWORD=changeme_grafana_reader
GRAFANA_ADMIN_PASSWORD=changeme_grafana_admin

# Must be exactly 32 characters. Kibana refuses to start otherwise.
KIBANA_ENCRYPTION_KEY=changeme_32_char_key_0123456789a

# ─── Resources ───────────────────────────────────────────────────────────────
# Elasticsearch heap. Rule of thumb: half the VM's RAM, never above 31g.
ES_HEAP=4g
LS_HEAP=1g

# ─── Ports published on the LAN ──────────────────────────────────────────────
ES_PORT=9200
KIBANA_PORT=5601
FLEET_PORT=8220
GRAFANA_PORT=3000
# TCP endpoint your application ships logs to.
LOGSTASH_TCP_PORT=5000
# Same, but TLS-wrapped.
LOGSTASH_TLS_PORT=5001

# ─── Retention ───────────────────────────────────────────────────────────────
# Days of logs to keep before deletion (applied via ILM in bootstrap.sh).
LOG_RETENTION_DAYS=30
METRIC_RETENTION_DAYS=90

# ─── Populated by bootstrap.sh — do not edit by hand ─────────────────────────
ES_CA_FINGERPRINT=
FLEET_SERVER_SERVICE_TOKEN=
