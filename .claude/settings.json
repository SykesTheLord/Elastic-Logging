{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/syntax-check.sh\"",
            "timeout": 20,
            "statusMessage": "Syntax-checking"
          }
        ]
      }
    ]
  }
}