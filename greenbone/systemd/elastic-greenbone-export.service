[Unit]
Description=Export finished Greenbone reports for Elastic Agent
Documentation=file:///usr/local/lib/gvm-export/gvm-export.py
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/gvm-export/gvm-export.py
# Root only for the gvmd socket, which the container creates owned by its own
# gvmd user.
User=root
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/log/elastic /var/lib/gvm-export
