# Greenbone VM settings. install.sh creates .env from this; or copy it to .env,
# edit, and run ./setup.sh. Apply later edits with ./update.sh.
# Never commit .env — it holds the admin password.

# ─── Web UI ──────────────────────────────────────────────────────────────────
# https://<this VM>:${GSA_PORT}, user "admin". The certificate is self-signed.
GSA_PORT=9392
GREENBONE_ADMIN_PASSWORD=changeme_greenbone_admin

# Feed release the data containers pull. Matches Greenbone's own compose file.
FEED_RELEASE=24.10

# ─── What to scan ────────────────────────────────────────────────────────────
# Comma-separated hosts, ranges or CIDRs. Greenbone's hard limit is 4096 hosts
# per target; a homelab /24 is far below it.
SCAN_TARGETS=192.168.1.0/24
# Comma-separated hosts to leave alone. The gateway is a good candidate if
# scanning it sets off its own IPS.
SCAN_EXCLUDE=

# When the scan runs, as an iCalendar RRULE, in SCAN_TZ. A full-and-fast scan
# of a /24 takes a few hours. The dashboard's default time range is 8 days, so
# anything at least weekly keeps every host on it. Keep the quotes: anything
# that sources this file would otherwise stop the value at the first ";".
SCAN_START=02:00
SCAN_RRULE="FREQ=WEEKLY;BYDAY=SU"
SCAN_TZ=Europe/London

# ─── Authenticated scanning ──────────────────────────────────────────────────
# setup.sh generates a key pair in secrets/ and prints the public half. Each
# host gets a user of this name with that key — via the agent installers'
# --scan-key, or vms/install-host-tools.sh on a host already enrolled.
SCAN_SSH_USER=greenbone-scan
SCAN_SSH_PORT=22

# ─── Export to Elasticsearch ─────────────────────────────────────────────────
# Results below this Quality of Detection are mostly guesses from banners.
# 70 is Greenbone's own default for reports.
MIN_QOD=70
